---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Rotten Deck Boards Gaithersburg MD | Soft Spot Repair" description="Soft, spongy, or visibly decayed boards are a safety hazard. We replace them cleanly and protect the surrounding structure.">
  <section class="page-hero">
    <div class="container">
      <h1>Rotten or Soft Deck Boards</h1>
      <p>Soft, spongy, or visibly decayed boards are a safety hazard. We replace them cleanly and protect the surrounding structure.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get Help — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
        <h2>Why Boards Rot in Maryland</h2>
        <p>Trapped moisture, failed sealers, and freeze-thaw cycles create ideal conditions for decay. Soft spots often start near railings, stairs, and areas with poor drainage.</p>
        <p>We cut out damaged boards, inspect the joists underneath, and install new material that matches your deck.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule an Inspection</a></p>
      </div>
    </div>
  </section>
</Layout>
