---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Fading Deck Finish Gaithersburg MD | Restain & Reseal" description="A failing finish lets moisture in and accelerates aging. Professional cleaning and resealing restores protection.">
  <section class="page-hero">
    <div class="container">
      <h1>Fading or Peeling Finish</h1>
      <p>A failing finish lets moisture in and accelerates aging. Professional cleaning and resealing restores protection.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get Help — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
        <h2>Keep the Barrier Intact</h2>
        <p>UV exposure and weather break down stains and sealers over time. When the finish looks dull, gray, or peeling, a professional clean and reapplication restores both appearance and moisture resistance.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule an Inspection</a></p>
      </div>
    </div>
  </section>
</Layout>
