---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Uneven or Sagging Deck Repair Gaithersburg MD" description="Sagging often signals joist or beam problems. We diagnose the cause and restore a level, safe surface.">
  <section class="page-hero">
    <div class="container">
      <h1>Uneven or Sagging Deck</h1>
      <p>Sagging often signals joist or beam problems. We diagnose the cause and restore a level, safe surface.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get Help — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
        <h2>More Than a Cosmetic Issue</h2>
        <p>An uneven or bouncing deck usually points to framing issues. We assess joists, beams, and posts, then sister, reinforce, or replace as required to bring the surface back to a safe, level plane.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule an Inspection</a></p>
      </div>
    </div>
  </section>
</Layout>
