---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Insect Damage Deck Repair Gaithersburg MD" description="Termites, carpenter ants, and borers can destroy framing from the inside. Early detection and proper repair protect the structure.">
  <section class="page-hero">
    <div class="container">
      <h1>Insect or Pest Damage</h1>
      <p>Termites, carpenter ants, and borers can destroy framing from the inside. Early detection and proper repair protect the structure.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get Help — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
        <h2>Hidden Damage Needs Attention</h2>
        <p>Insect activity often goes unnoticed until boards feel soft or frass appears. We evaluate the extent of damage, replace compromised members, and recommend follow-up treatment when appropriate.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule an Inspection</a></p>
      </div>
    </div>
  </section>
</Layout>
