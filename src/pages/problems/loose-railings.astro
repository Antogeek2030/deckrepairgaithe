---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Loose Deck Railings Gaithersburg MD | Safety Repair" description="A railing that moves is a fall risk. We reinforce posts and restore solid, reliable protection.">
  <section class="page-hero">
    <div class="container">
      <h1>Loose or Wobbly Railings</h1>
      <p>A railing that moves is a fall risk. We reinforce posts and restore solid, reliable protection.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get Help — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
        <h2>Fix It Before Someone Gets Hurt</h2>
        <p>Loose railings are one of the most common and most dangerous deck problems. We strengthen the connection at the post base, replace compromised posts when needed, and verify the finished assembly feels solid.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule an Inspection</a></p>
      </div>
    </div>
  </section>
</Layout>
