---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout
  title="Deck Repair Blog | Tips for Gaithersburg Homeowners"
  description="Practical advice on deck maintenance, repair vs replacement, safety, and living with Maryland weather — from the local team at Deck Repair Gaithersburg."
>
  <section class="page-hero">
    <div class="container">
      <h1>Deck Repair Blog</h1>
      <p>Tips, guides, and local advice for keeping your outdoor space safe and looking great in Gaithersburg and Montgomery County.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card" style="display:block">
            <div class="blog-card-body">
              <div class="date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
