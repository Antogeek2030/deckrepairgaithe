---
import Layout from '../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Contact Us | Deck Repair Gaithersburg MD" description="Call or text for a same-day or next-day deck repair estimate in Gaithersburg and Montgomery County.">
  <section class="page-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Ready for an estimate? Reach out today — we respond quickly.</p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose" style="text-align:center">
        <h2>Call or Text</h2>
        <p style="font-size:1.5rem;font-weight:700;margin:1rem 0">
          <a href={`tel:${phone}`} style="color:var(--primary)">{phoneDisplay}</a>
        </p>
        <p>Mon–Sun 7am – 7pm</p>
        <h2 style="margin-top:2.5rem">Visit / Service Base</h2>
        <p>105 W Diamond Ave<br />Gaithersburg, MD 20877</p>
        <p style="margin-top:1.5rem">Serving Gaithersburg and all of Montgomery County.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Call Now</a></p>
      </div>
    </div>
  </section>
</Layout>
