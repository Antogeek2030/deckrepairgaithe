---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Deck Safety Inspection Gaithersburg MD" description="Thorough visual and structural assessment with a clear written report and prioritized recommendations.">
  <section class="page-hero">
    <div class="container">
      <h1>Deck Safety Inspection in Gaithersburg, MD</h1>
      <p>Thorough visual and structural assessment with a clear written report and prioritized recommendations.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get a Quote — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
<h2>Know Exactly Where Your Deck Stands</h2>
<p>Our inspection covers boards, railings, stairs, joists (where visible), ledger connections, and overall stability. You receive photos and a prioritized list of recommended repairs.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule Deck Safety Inspection in Gaithersburg, MD</a></p>
      </div>
    </div>
  </section>
</Layout>
