---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Structural Deck Repair Gaithersburg MD | Joists & Beams" description="Joist sistering, beam reinforcement, ledger board work, and footing repairs that restore long-term stability.">
  <section class="page-hero">
    <div class="container">
      <h1>Structural Deck Repair in Gaithersburg, MD</h1>
      <p>Joist sistering, beam reinforcement, ledger board work, and footing repairs that restore long-term stability.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get a Quote — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
<h2>Addressing the Structure Beneath</h2>
<p>Surface boards can look fine while joists or beams are compromised. We inspect and repair the load-bearing elements so your deck stays safe for years.</p>
<ul>
<li>Joist sistering and replacement</li>
<li>Beam and post reinforcement</li>
<li>Ledger board and flashing assessment</li>
<li>Footing and post-base work</li>
</ul>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule Structural Deck Repair in Gaithersburg, MD</a></p>
      </div>
    </div>
  </section>
</Layout>
