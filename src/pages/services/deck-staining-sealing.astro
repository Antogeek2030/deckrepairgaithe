---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Deck Staining & Sealing Gaithersburg MD" description="Professional cleaning, preparation, and application of quality stains and sealers that stand up to Maryland weather.">
  <section class="page-hero">
    <div class="container">
      <h1>Deck Staining & Sealing in Gaithersburg, MD</h1>
      <p>Professional cleaning, preparation, and application of quality stains and sealers that stand up to Maryland weather.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get a Quote — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
<h2>Protect and Refresh Your Deck</h2>
<p>A good finish is the single best defense against moisture, UV damage, and premature aging. We clean thoroughly, prep the surface, and apply products suited to our climate.</p>
<ul>
<li>Deep cleaning and brightening</li>
<li>Sanding and mildew treatment as needed</li>
<li>Premium penetrating stains and sealers</li>
<li>UV and water-repellent protection</li>
</ul>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule Deck Staining & Sealing in Gaithersburg, MD</a></p>
      </div>
    </div>
  </section>
</Layout>
