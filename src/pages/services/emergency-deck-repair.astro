---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Emergency Deck Repair Gaithersburg MD" description="Rapid response when a board fails or a railing becomes unsafe. We stabilize the area and complete permanent repairs.">
  <section class="page-hero">
    <div class="container">
      <h1>Emergency Deck Repair in Gaithersburg, MD</h1>
      <p>Rapid response when a board fails or a railing becomes unsafe. We stabilize the area and complete permanent repairs.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get a Quote — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-page">
    <div class="container">
      <div class="prose">
<h2>When Safety Cannot Wait</h2>
<p>If a board has collapsed or a railing feels unsafe, call us. We prioritize emergency slots, secure the area, and move quickly to a lasting fix.</p>
        <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Schedule Emergency Deck Repair in Gaithersburg, MD</a></p>
      </div>
    </div>
  </section>
</Layout>
